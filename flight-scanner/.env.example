# Copia questo file in `.env` e valorizza le variabili.

# Topic NTFY a cui inviare le notifiche (es. mio-topic)
# Lo script notificherà su https://<NTFY_SERVER>/<NTFY_TOPIC>
NTFY_TOPIC=mio-topic

# Server NTFY (opzionale, default: ntfy.sh)
# NTFY_SERVER=ntfy.sh

# Token se il topic è protetto (opzionale)
# NTFY_TOKEN=
