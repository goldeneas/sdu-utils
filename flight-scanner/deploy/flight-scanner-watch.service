[Unit]
Description=flight-scanner deal watcher (Odense <-> Salerno)
# One-shot check: run it from a timer, not as a long-lived daemon.

[Service]
Type=oneshot
WorkingDirectory=%h/Workspace/sdu-utils/flight-scanner
ExecStart=%h/Workspace/sdu-utils/flight-scanner/run.sh watch --config %h/.config/flight-scanner/config.toml
# If you installed the package (pip install -e .), use instead:
# ExecStart=%h/.local/bin/flight-scanner-watch --config %h/.config/flight-scanner/config.toml
StandardOutput=journal
StandardError=journal
